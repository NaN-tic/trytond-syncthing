<?xml version="1.0"?>
<tryton>
    <data>
        <record model="syncthing.configuration" id="configuration"/>

        <record model="ir.ui.view" id="view_category_form">
            <field name="model">office.category</field>
            <field name="inherit" ref="office.view_category_form"/>
            <field name="name">category_form</field>
        </record>
        <record model="ir.ui.view" id="view_user_form">
            <field name="model">res.user</field>
            <field name="inherit" ref="res.user_view_form"/>
            <field name="name">user_form</field>
        </record>
        <record model="ir.ui.view" id="view_user_form_preferences">
            <field name="model">res.user</field>
            <field name="inherit" ref="res.user_view_form_preferences"/>
            <field name="name">user_form_preferences</field>
        </record>
        <record model="ir.ui.view" id="view_device_form">
            <field name="model">syncthing.device</field>
            <field name="type">form</field>
            <field name="name">device_form</field>
        </record>
        <record model="ir.ui.view" id="view_device_list">
            <field name="model">syncthing.device</field>
            <field name="type">tree</field>
            <field name="name">device_list</field>
        </record>

        <record model="ir.model.access" id="access_device">
            <field name="model">syncthing.device</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>
        <record model="ir.model.access" id="access_configuration_admin">
            <field name="model">syncthing.configuration</field>
            <field name="group" ref="office.group_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>
        <record model="ir.rule.group" id="rule_group_device_user">
            <field name="name">Own Syncthing Devices</field>
            <field name="model">syncthing.device</field>
            <field name="global_p" eval="True"/>
        </record>
        <record model="ir.rule" id="rule_device_user">
            <field name="domain" eval="[('user', '=', Eval('user_id', -1))]"
                pyson="1"/>
            <field name="rule_group" ref="rule_group_device_user"/>
        </record>
    </data>
</tryton>
